<Window x:Class="WarsOfLibertyLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:WarsOfLibertyLauncher.Controls"
        Title="AoE3 Mod Launcher"
        Height="700" Width="1100"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgBase}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <!-- WindowChrome (caption drag + edge-resize + snap/Aero) is applied
         centrally in App.OnAnyWindowLoaded from the TitleBarHeight token; the
         title bar itself is the shared controls:TitleBar below (Grid.Row=0). -->

    <Window.Resources>
        <!-- The dark ToolTip style moved to App.xaml (app-wide) so it also
             reaches the gear ContextMenu popup and the standalone dialogs, and
             so long tooltips wrap instead of clipping. Don't re-add it here. -->

        <!-- Notification rows paint the icon of the mod they are about, resolved
             from the item's ModId through the shared icon cache. Both converters
             return "no icon" for kinds with no mod (launcher update, connectivity)
             and for items whose mod has left the catalog — the row then falls back
             to the per-kind glyph. -->
        <controls:ModIconConverter x:Key="ModIconConv"/>
        <controls:ModIconPresentConverter x:Key="ModIconPresentConv"/>

        <!-- (Removed local SidebarPrimaryButton style — the redesign
             relies on the global one from Styles/Buttons.xaml which
             has the gold gradient + glow effect. Window.Resources used
             to override it with a flat fill, which defeated the
             premium hero CTA look.) -->

        <!-- Sidebar action buttons coded by operation. Background + border
             come from each button instance, so the same template handles
             every color variant: cyan for Update, purple for Verify, amber
             for Repair, soft-red for Uninstall, etc. -->
        <Style x:Key="SidebarColoredButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
<Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar secondary actions — Actualizar, Configuración, Abrir
             carpeta, Verificar archivos. Stretched full width, left-aligned
             label so they line up like a settings list. -->
        <Style x:Key="SidebarSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2a2d34"/>
            <Setter Property="Foreground" Value="#ddd"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3a3d44"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#22252c"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabled}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tabs across the top of the right-hand content panel. The active
             tab gets its underline + brighter foreground programmatically
             from RefreshTabs() in code-behind. -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="Margin" Value="0,0,28,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="{DynamicResource BgPanelAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="8"/>
        </Style>

        <!-- Thin dark scrollbar — replaces the Windows-default light gray
             one so it blends with the rest of the theme. Track is fully
             transparent; the thumb is a subtle pill that brightens on
             hover/drag. The up/down repeat buttons are templated to empty
             so the bar is a pure track + thumb (matches VS Code / Discord
             / Spotify). -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="#3a3d44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5a5d64"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Empty repeat-button template so the up/down arrows disappear
             from the scrollbar without breaking its hit-testing. -->
        <Style x:Key="ScrollBarHiddenButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarHiddenButton}"
                                                  Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarHiddenButton}"
                                                  Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Horizontal variant — same template but with a thin height. -->
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Default ScrollViewer padding: reserves a thin gutter on the
             right so when the scrollbar appears it doesn't push the
             content sideways. The scrollbar is 6 px wide and we reserve 8
             so it has 1 px of breathing room on each side. -->
        <Style TargetType="ScrollViewer">
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>

        <!-- The Min/Max/Close caption-button styles moved to the global
             Styles/Chrome.xaml (TitleBarButton / TitleBarCloseButton),
             consumed by the shared controls:TitleBar — no per-window copy. -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom title bar (shared controls:TitleBar, height = TitleBarHeightMain
                 token; the slim 28px is secondary-windows only). It now carries the
                 three main tabs as well — the separate nav strip that used to be row 1
                 is gone (design handoff 1a: five stacked bars down to two). -->
            <RowDefinition Height="Auto"/>   <!-- Title bar -->
            <RowDefinition Height="Auto"/>   <!-- Nav tabs -->
            <RowDefinition Height="*"/>      <!-- App content -->
        </Grid.RowDefinitions>

        <!-- =============================================================
             ROW 0 - TITLE BAR (36px). Deliberately almost empty: the brand,
             the version chip, and the three chrome affordances that belong
             beside the caption buttons. Every other pixel is window-drag.

             The three main tabs used to live in here (handoff 1a folded the
             nav strip into the bar); the header reference splits them back
             out into row 1. Not a revert for its own sake - a chrome row with
             nothing but a wordmark can afford to BE the drag handle, which is
             what makes the window feel native, and it gives the active tab a
             seam to underline.

             NO bottom border, on purpose: the nav row below is a different
             fill, so the two read as separate surfaces with no rule between
             them, and the rule the CONTENT needs is the nav row's own.

             Height is TitleBarHeightMain and nothing else may set it -
             App.ApplyWindowChrome derives WindowChrome.CaptionHeight from that
             same token, and the caption region IS the drag region. Set one
             without the other and part of a row silently stops (or starts)
             dragging the window.
             ============================================================= -->
        <controls:TitleBar Grid.Row="0"
                           Background="{DynamicResource ChromeTitleBg}"
                           Height="{StaticResource TitleBarHeightMain}"
                           ButtonWidth="46"
                           GlyphSize="10"
                           CloseGlyphSize="13"
                           ShowMinimize="True"
                           ShowMaximize="True"
                           ShowClose="True">
                <!-- Column 0 of the shared TitleBar template ends exactly where the
                     caption buttons begin, so anything right-aligned in here lands
                     immediately left of them with no arithmetic. That is what retired
                     the hand-computed insets this row used to carry (bell at 148 from
                     the right, offline chip at 200, the content grid stopping at 58 -
                     all derived from ButtonWidth 46 x 3).

                     NOTE what is NOT set here: IsHitTestVisibleInChrome. On the grid it
                     would make the whole bar hit-testable and kill the drag; each
                     interactive child sets it for itself instead. The flag does NOT
                     inherit into a ContentControl's Content (the content's inheritance
                     parent is the TitleBar, not the template's ContentPresenter), so
                     "the template already sets it" is no substitute - that exact
                     assumption once left these controls dead to the first click. -->
                <Grid Height="{StaticResource TitleBarHeightMain}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>   <!-- brand -->
                        <ColumnDefinition Width="Auto"/>   <!-- version chip -->
                        <ColumnDefinition Width="*"/>      <!-- drag handle -->
                        <ColumnDefinition Width="Auto"/>   <!-- self-update pill -->
                        <ColumnDefinition Width="Auto"/>   <!-- offline chip -->
                        <ColumnDefinition Width="Auto"/>   <!-- notification bell -->
                    </Grid.ColumnDefinitions>

                <Button x:Name="TitleBarBrandButton"
                        Grid.Column="0"
                        VerticalAlignment="Stretch"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand"
                        Click="BrandMenuButton_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <!-- Muted at rest so the hover has something to lift AGAINST;
                                 the scale is rest #93A4B5 (7.31:1) → hover #F0F5FB
                                 (17.04:1) → pressed/open #FFFFFF (18.67:1). The hover
                                 used to be ChromeTextSoft, one rung lower, and was
                                 reported as looking the same as rest: a screenshot taken
                                 WITH the pointer on the button was indistinguishable from
                                 one taken without it. Pressed/open stop at pure white so
                                 the three states remain three — the chevron flip is the
                                 only other signal that the menu is open. -->
                            <Setter Property="Foreground" Value="{DynamicResource ChromeTextDim}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border"
                                                Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Left"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ChromeTextBright}"/>
                                            </Trigger>
                                            <!-- Pressed + Open after hover so
                                                 they win when both match; pure
                                                 white vs hover's near-white
                                                 keeps press/open distinct. -->
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="Tag" Value="open">
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Source is the 256x256 PNG (sibling to AppIcon.ico,
                             see csproj) NOT the .ico, because WPF's ICO codec
                             picks the smallest frame >= the requested logical
                             size and downscales it: at 20-logical-pixels it
                             selects the 24x24 frame and stretches, which is
                             visibly soft. The PNG decoder skips that frame
                             selection — HighQuality bicubic downscales the
                             native 256x256 directly to the physical pixel
                             size, which lands crisp at every DPI (the global
                             UseLayoutRounding + Display formatting from
                             App.OnStartup pin it to integer device pixels).
                             DecodePixelWidth=256 decodes the NATIVE frame so the
                             only resample is the renderer's single HighQuality
                             bicubic downscale (256 → the physical box). The
                             earlier 64 cap pre-shrank in the decoder first, so a
                             non-integer second downscale softened the icon;
                             decoding native keeps it as sharp as it can be. Costs
                             ~256 KB RAM instead of ~16 KB — trivial, and worth it
                             for a crisp brand mark. (16x16 per the header reference;
                             this replaced an earlier 20x20 rule — the maintainer was
                             shown that a detailed raster mark loses detail at that
                             size and chose fidelity, so softness here is accepted,
                             not a regression.) -->
                        <Image Width="16" Height="16"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Source>
                                <BitmapImage UriSource="pack://application:,,,/AppIcon.png"
                                             DecodePixelWidth="256"
                                             CacheOption="OnLoad"/>
                            </Image.Source>
                            <!-- FULL opacity, and no Style at all. The icon used to sit
                                 at 0.7 and brighten to 1.0 on hover, back when the
                                 wordmark beside it was near-white serif and the mark had
                                 to stay behind it. Against the near-black bar that costs
                                 ~23% of the brightness of artwork that is already dark
                                 (mean luminance 77/255 at render size), which is what made
                                 the whole block read as washed out. The reference asks for
                                 a size and a colour and says nothing about opacity — the
                                 dimming was ours. The button still answers the mouse: the
                                 wordmark and the chevron follow the template's Foreground
                                 triggers, so the affordance survives without knocking the
                                 mark back at rest. -->
                        </Image>
                        <!-- Body font, 12, muted — the prototype's wordmark. Its COLOUR is
                             not set here on purpose: it comes from the button's Style
                             setter so the hover/open triggers can still override it.
                             A local Foreground would beat those triggers and kill the
                             illumination, which is the precedence trap this button has
                             already been bitten by twice. -->
                        <TextBlock Text="AoE3 Mod Launcher"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="{DynamicResource MpMetaSize}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <!-- Chevron flips ▾↔▴ in code-behind on open/close to signal
                             the dropdown is expanded. Named so BrandMenuButton_Click can
                             swap the glyph.

                             No Opacity: it carried a LOCAL 0.7 that nothing ever raised —
                             unlike the icon's, which at least lifted on hover — so it was
                             the one permanently dimmed element in the bar, compositing to
                             4.13:1 against 7.31:1 for the text it sits beside. With it
                             gone the chevron inherits the button's Foreground and finally
                             illuminates WITH the wordmark. -->
                        <TextBlock x:Name="BrandChevron"
                                   Text="&#xE70D;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Margin="6,1,0,0"/>
                    </StackPanel>
                </Button>
                <!-- Version of the RUNNING binary, from
                     LauncherUpdateService.CurrentInformationalTag (always "v"-prefixed,
                     and the only source that keeps a WoL-style letter suffix). Static:
                     no IsHitTestVisibleInChrome, so it is part of the drag handle. That
                     also means it can carry no tooltip - a caption hit never raises
                     IsMouseOver - which is fine for a label already fully visible.

                     It took TWO lifts to become legible, and the second is the
                     interesting one. First the text went from the ChromeTextFaint the
                     reference names to ChromeTextDim: at 11px faint measured 3.67:1,
                     under the 4.5:1 floor, and was reported as unreadable. That fixed
                     the letters and NOT the chip — with no background at all it still
                     read as loose text beside a hairline, because a 2.09:1 rim has
                     nothing to cut the shape out of. So it now carries a fill
                     (ChromeVersionBg) and the text sits at ChromeTextSoft, 11.79:1.

                     A local Foreground is safe HERE because the chip is a SIBLING of the
                     brand button, not part of its content — inside it, a local value
                     would beat the template's illumination triggers, which is the trap
                     that has broken this button twice. -->
                <Border x:Name="VersionChip"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Padding="6,2"
                        CornerRadius="{StaticResource ChromeVersionRadius}"
                        Background="{DynamicResource ChromeVersionBg}"
                        BorderBrush="{DynamicResource ChromeVersionRim}"
                        BorderThickness="1">
                    <TextBlock x:Name="VersionChipText"
                               FontFamily="{DynamicResource BodyFont}"
                               FontSize="{StaticResource ChromeVersionSize}"
                               Foreground="{DynamicResource ChromeTextSoft}"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Persistent, non-invasive launcher self-update reminder.
                     Replaces the old auto-modal that got permanently silenced
                     on Cancel (SkippedLauncherTag). Shown whenever a newer
                     launcher version exists; stays visible on EVERY launch until
                     the user updates (no permanent dismiss). Click opens the
                     existing download/restart dialog. Gold pill with dark text
                     for contrast; pulses once per session (LauncherUpdatePillScale).
                     Self-contained template so the global Button style doesn't
                     flatten the pill look. IsHitTestVisibleInChrome=True so the
                     window-drag handler doesn't swallow the click. Text + tooltip
                     are localized from code-behind. -->
                <Button x:Name="LauncherUpdatePill"
                        Grid.Column="3"
                        Visibility="Collapsed"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        FontFamily="{DynamicResource BodyFont}"
                        FontSize="{DynamicResource FontSizeCaption}"
                        Click="LauncherUpdatePill_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        RenderTransformOrigin="0.5,0.5">
                    <Button.RenderTransform>
                        <ScaleTransform x:Name="LauncherUpdatePillScale" ScaleX="1" ScaleY="1"/>
                    </Button.RenderTransform>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <!-- The text comes from the Button's Content (set in
                                 code-behind) via the ContentPresenter — x:Name'd
                                 elements inside a ControlTemplate live in their own
                                 namescope and aren't reachable from code-behind, so
                                 we drive the label through Content instead. -->
                            <Border x:Name="pillBorder"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="10,3">
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            TextElement.Foreground="#1A1A1A"
                                            TextElement.FontWeight="SemiBold">
                                    <TextBlock Text="&#xE777;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="pillBorder" Property="Opacity" Value="0.88"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="OfflineChip"
                        Grid.Column="4"
                        Margin="0,0,6,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Visibility="Collapsed"
                    Cursor="Hand"
                    VerticalAlignment="Center"
                    Click="OfflineChip_Click"
                    FontFamily="{DynamicResource BodyFont}"
                    FontSize="{DynamicResource FontSizeCaption}"
                    ToolTipService.InitialShowDelay="400"
                    ToolTipService.ShowDuration="8000">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="chipBorder"
                                Background="#33201A18"
                                BorderBrush="{DynamicResource MpStatusOffline}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}"
                                Padding="8,2">
                            <!-- Label comes from the Button's Content (set in
                                 code-behind) — an x:Name'd element inside a
                                 ControlTemplate lives in its own namescope and
                                 isn't reachable from code-behind, so we drive the
                                 text through Content + ContentPresenter, like the
                                 launcher-update pill above. -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        TextElement.Foreground="{DynamicResource MpStatusOffline}">
                                <Ellipse Width="8" Height="8"
                                         Fill="{DynamicResource MpStatusOffline}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="chipBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
                <Button x:Name="NotificationBellButton"
                        Grid.Column="5"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="NotificationBell_Click"
                    MouseEnter="NotificationBell_MouseEnter"
                    MouseLeave="NotificationBell_MouseLeave"
                    VerticalAlignment="Stretch"
                    ToolTipService.InitialShowDelay="500"
                    ToolTipService.ShowDuration="5000"
                    Style="{StaticResource NotificationBellButton}">
                <Button.ToolTip>
                    <ToolTip x:Name="NotifToolTip"
                             Style="{StaticResource NotifToolTipStyle}"
                             Content="Notificaciones"/>
                </Button.ToolTip>
                <Grid Width="24" Height="24">
                    <!-- Bell drawn as a SOLID vector path (gold) rather than a
                         Segoe MDL2 glyph (which renders as an outline). The pulse
                         animation (PulseNotificationBell) rotates NotificationBellRotate. -->
                    <Path x:Name="NotificationBellGlyph"
                          Fill="#99FFFFFF"
                          Stroke="Black"
                          StrokeThickness="0.6"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"
                          Width="16" Height="16"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.15"
                          Data="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="NotificationBellRotate" Angle="0"/>
                        </Path.RenderTransform>
                    </Path>
                    <!-- Small unread indicator dot (7px), top-right corner. Thin
                         dark ring separates it from the bell / bar. -->
                    <Ellipse x:Name="NotificationDot"
                             Width="7" Height="7"
                             Fill="#E5484D"
                             Stroke="{DynamicResource ChromeTitleBg}"
                             StrokeThickness="1"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,0,-1,0"
                             Visibility="Collapsed"/>
                </Grid>
            </Button>

                </Grid>
        </controls:TitleBar>

        <!-- The notification panel stays a sibling of the TitleBar rather than a child
             of it: a Popup renders in its own HWND and is positioned against its
             PlacementTarget, so it does not need to live inside the bar - and keeping
             it out means the bar's content grid holds only bar-height controls. -->
        <Grid Grid.Row="0" Panel.ZIndex="10">
            <!-- Dropdown panel. Right-aligned under the bell (HorizontalOffset
                 shifts the 360-wide card left so its right edge lands near the
                 bell). Items + empty-state visibility are wired in code-behind. -->
            <Popup x:Name="NotificationPopup"
                   PlacementTarget="{Binding ElementName=NotificationBellButton}"
                   Placement="Bottom"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   HorizontalOffset="-316"
                   VerticalOffset="2">
                <!-- Same two-tone rim + surface as the brand and MODS menus: the three
                     hang off this one bar and used to disagree on surface, rim, radius
                     and shadow all at once. The shadow rides the OUTER band so it skirts
                     the whole composite rim instead of being clipped behind it. -->
                <Border Margin="8"
                        Background="{DynamicResource MenuBorderOuter}"
                        CornerRadius="{StaticResource RadiusPopupOuter}"
                        Padding="1"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
                    </Border.Effect>
                <Border Width="360"
                        Background="{DynamicResource ChromePopupBg}"
                        BorderBrush="{DynamicResource MenuBorder}"
                        BorderThickness="2"
                        CornerRadius="{StaticResource RadiusPopupInner}">
                    <DockPanel LastChildFill="True">
                        <!-- Header -->
                        <Grid DockPanel.Dock="Top" Margin="14,12,10,8">
                            <TextBlock x:Name="NotificationPanelTitle"
                                       Text="Notifications"
                                       Foreground="{DynamicResource ChromeTextStrong}"
                                       FontFamily="{DynamicResource DisplayFont}"
                                       FontSize="{DynamicResource FontSizeBody}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <Button x:Name="NotificationMarkAllRead"
                                        Click="NotificationMarkAllRead_Click"
                                        Content="Mark all read"
                                        Style="{StaticResource NotifLinkButton}"/>
                                <TextBlock Text="·"
                                           Foreground="{DynamicResource ChromeTextDim}"
                                           Margin="6,0"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="NotificationClearAll"
                                        Click="NotificationClearAll_Click"
                                        Content="Clear"
                                        Style="{StaticResource NotifLinkButton}"/>
                            </StackPanel>
                        </Grid>

                        <Border DockPanel.Dock="Top"
                                Height="1"
                                Background="{DynamicResource MpDivider}"/>

                        <!-- Empty state -->
                        <TextBlock x:Name="NotificationEmptyText"
                                   DockPanel.Dock="Top"
                                   Text="No notifications"
                                   Foreground="{DynamicResource ChromeTextDim}"
                                   HorizontalAlignment="Center"
                                   Margin="0,28,0,30"
                                   Visibility="Collapsed"/>

                        <!-- Items -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      MaxHeight="380">
                            <ItemsControl x:Name="NotificationList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding}"
                                                Click="NotificationItem_Click"
                                                HorizontalContentAlignment="Stretch"
                                                Style="{StaticResource NotifRowButton}">
                                            <Grid Margin="14,9,12,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Mod icon + kind badge. The icon says WHICH mod,
                                                     the badge says WHAT happened; the badge reuses the
                                                     same per-kind glyph and colour the big fallback
                                                     glyph uses, so the two can't drift. -->
                                                <Grid Grid.Column="0"
                                                      Width="34" Height="34"
                                                      VerticalAlignment="Top"
                                                      Margin="0,1,10,0"
                                                      Visibility="{Binding ModId, Converter={StaticResource ModIconPresentConv}}">
                                                    <Border CornerRadius="6"
                                                            Background="{Binding ModId, Converter={StaticResource ModIconConv}}"
                                                            BorderBrush="{DynamicResource BorderSubtle}"
                                                            BorderThickness="1"/>
                                                    <Border HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Width="15" Height="15"
                                                            Margin="0,0,-3,-3"
                                                            CornerRadius="7.5"
                                                            Background="{DynamicResource BgPanel}"
                                                            BorderBrush="{DynamicResource BgBase}"
                                                            BorderThickness="1.5">
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="8"
                                                                   Foreground="{DynamicResource ChromeTextDim}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="&#xEA8F;"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="UpdateAvailable">
                                                                            <Setter Property="Text" Value="&#xE896;"/>
                                                                            <Setter Property="Foreground" Value="#5AA9E6"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="UpdateFinished">
                                                                            <Setter Property="Text" Value="&#xE930;"/>
                                                                            <Setter Property="Foreground" Value="#62C462"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="NewTranslation">
                                                                            <Setter Property="Text" Value="&#xF2B7;"/>
                                                                            <Setter Property="Foreground" Value="#D8B66A"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="NewMod">
                                                                            <Setter Property="Text" Value="&#xE710;"/>
                                                                            <Setter Property="Foreground" Value="#B48AD8"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Installed">
                                                                            <Setter Property="Text" Value="&#xE73E;"/>
                                                                            <Setter Property="Foreground" Value="#62C462"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="RoomCreated">
                                                                            <Setter Property="Text" Value="&#xE902;"/>
                                                                            <Setter Property="Foreground" Value="#5AA9E6"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Kind}" Value="MatchRated">
                                                                            <Setter Property="Text" Value="&#xE735;"/>
                                                                            <Setter Property="Foreground" Value="#E0B44C"/>
                                                                        </DataTrigger>
                                                                        <!-- Project news. Without a trigger a new kind
                                                                             silently falls back to the default bell
                                                                             glyph, which reads as an ordinary update. -->
                                                                        <DataTrigger Binding="{Binding Kind}" Value="Announcement">
                                                                            <Setter Property="Text" Value="&#xE789;"/>
                                                                            <Setter Property="Foreground" Value="#E6A54C"/>
                                                                        </DataTrigger>
                                                                        <!-- A patch for a mod that is NOT installed. Its
                                                                             own glyph, because it is not the same claim
                                                                             as UpdateAvailable: there is nothing here to
                                                                             update, only something published. -->
                                                                        <DataTrigger Binding="{Binding Kind}" Value="ModPatchPublished">
                                                                            <Setter Property="Text" Value="&#xE7B8;"/>
                                                                            <Setter Property="Foreground" Value="#5AA9E6"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>

                                                <!-- Fallback: no mod to show (launcher update, connectivity)
                                                     or the mod is gone from the catalog. Notifications persist
                                                     across sessions, so this case is normal, not an error. -->
                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Top"
                                                           Margin="0,1,10,0"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="16"
                                                           Visibility="{Binding ModId, Converter={StaticResource ModIconPresentConv}, ConverterParameter=invert}"
                                                           Foreground="{DynamicResource ChromeTextDim}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="&#xEA8F;"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="UpdateAvailable">
                                                                    <Setter Property="Text" Value="&#xE896;"/>
                                                                    <Setter Property="Foreground" Value="#5AA9E6"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="UpdateFinished">
                                                                    <Setter Property="Text" Value="&#xE930;"/>
                                                                    <Setter Property="Foreground" Value="#62C462"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="NewTranslation">
                                                                    <Setter Property="Text" Value="&#xF2B7;"/>
                                                                    <Setter Property="Foreground" Value="#D8B66A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="LauncherUpdate">
                                                                    <Setter Property="Text" Value="&#xE777;"/>
                                                                    <Setter Property="Foreground" Value="#D4A04A"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Connectivity">
                                                                    <Setter Property="Text" Value="&#xE774;"/>
                                                                    <Setter Property="Foreground" Value="#8AA0B4"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="NewMod">
                                                                    <Setter Property="Text" Value="&#xE710;"/>
                                                                    <Setter Property="Foreground" Value="#B48AD8"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Kind}" Value="Installed">
                                                                    <Setter Property="Text" Value="&#xE73E;"/>
                                                                    <Setter Property="Foreground" Value="#62C462"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- Title + body + time -->
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{DynamicResource ChromeTextStrong}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Body}"
                                                               Foreground="{DynamicResource ChromeTextDim}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Margin="0,1,0,0"/>
                                                    <TextBlock Text="{Binding CreatedLocal, StringFormat='{}{0:dd MMM, HH:mm}'}"
                                                               Foreground="{DynamicResource ChromeTextDim}"
                                                               FontSize="11"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <!-- Unread dot -->
                                                <Ellipse Grid.Column="2"
                                                         Width="8" Height="8"
                                                         Margin="8,4,0,0"
                                                         VerticalAlignment="Top"
                                                         Fill="#E5484D">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Read}" Value="True">
                                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                </Border>
            </Popup>
        </Grid>

        <!-- =============================================================
             ROW 1 - NAV. The three main tabs, and the player's state on the
             right. Ordinary client area: it sits BELOW CaptionHeight, so every
             control in here gets normal hit-testing, hover and tooltips with
             no chrome flags at all.

             Its bottom rule is the chrome/content seam for all three tabs.
             Multiplayer draws its own sub-tab bar under this, but Library and
             Workshop have nothing, so without this line the chrome would bleed
             straight into their content. (That rule used to live on the content
             wrapper below, back when the bar it separated from was the title
             bar itself.)
             ============================================================= -->
        <Border Grid.Row="1"
                x:Name="MainNav"
                Height="{StaticResource MainNavHeight}"
                Background="{DynamicResource ChromeNavBg}"
                BorderBrush="{DynamicResource ChromeNavRule}"
                BorderThickness="0,0,0,1">
            <Grid Margin="{StaticResource MainNavPadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- MAIN TABS. Same x:Names as ever, so every code-behind consumer
                     (SwitchTopTab, RefreshTopTabHighlight, ApplyStrings,
                     ApplyTopTabOrder, the click handlers) keeps working untouched.
                     Declared HERE rather than in a UserControl because ApplyTopTabOrder
                     clears and refills TopTabBar.Children, which needs the panel in
                     MainWindow's namescope - the same reason TitleBar is a templated
                     ContentControl.

                     The left-to-right child order is re-applied at startup from
                     LauncherConfig.TopTabOrder; the order here is just the default for
                     a fresh config. -->
                <StackPanel x:Name="TopTabBar"
                            Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch">
                    <Button x:Name="TopTabPlay"
                            Style="{StaticResource NavTabButton}"
                            Click="TopTabPlay_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SidebarLabelDashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TopTabMods"
                            Style="{StaticResource NavTabButton}"
                            Click="TopTabMods_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="SidebarLabelCatalog" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="TopTabMultiplayer"
                            Style="{StaticResource NavTabButton}"
                            Click="TopTabMultiplayer_Click">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="SidebarLabelMultiplayer" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- "New room created" dot: set from PollNewRoomsAsync,
                                 cleared when the user switches to Multiplayer. Its
                                 Stroke must track the fill of whatever bar the tab
                                 sits on, so the ring reads as a cut-out and not a halo — hence the NAV
                                 row's brush, not the title bar's. It has moved once
                                 already; move it again if the tabs do. -->
                            <Ellipse x:Name="MultiplayerTabDot"
                                     Width="7" Height="7"
                                     Fill="#E5484D"
                                     Stroke="{DynamicResource ChromeNavBg}"
                                     StrokeThickness="1"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-2,-4,0"
                                     Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Connection capsule. Radmin's full-width green banner used to sit
                         permanently in the Multiplayer tab restating "everything is
                         fine"; it collapses to this, and the banner only returns when
                         something is actually wrong. Driven by MultiplayerTab's own
                         Radmin poll through SetConnectionChip, so there is exactly one
                         probe and one source of truth.

                         Collapsed by default: it appears once the poll reports Radmin
                         ready and hides the moment it isn't. Global rather than
                         Multiplayer-only, per the reference.

                         The detail is the bare 26.x address. What that address IS lives
                         in the tooltip instead - which only works because the capsule is
                         client area now; in the title bar a tooltip could never fire.

                         NOT clickable, and that is the second answer to the same
                         question. It WAS briefly a Button — the door to the Radmin guide,
                         because retiring the permanent banner took the guide's only other
                         door with it. That failed on both halves at once: a status
                         readout does not read as pressable (its whole affordance was a
                         hand cursor and a rim shift between two nearly invisible greys),
                         and even pressed it never said what it did. A "?" beside it was tried
                         next and failed for the other half of the same reason: a symbol
                         says help exists but never says about what. The door is now a
                         LABELLED button in the Multiplayer tab, which is where Radmin
                         matters at all. -->
                    <Border x:Name="ConnectionChip"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0"
                            Padding="12,0"
                            Height="{StaticResource ChromeCapsuleHeight}"
                            CornerRadius="{StaticResource ChromeCapsuleRadius}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource ChromeRim}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7"
                                     Fill="{DynamicResource ChromeOk}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0"/>
                            <TextBlock x:Name="ConnectionChipStatus"
                                       Foreground="{DynamicResource ChromeTextSoft}"
                                       FontFamily="{DynamicResource BodyFont}"
                                       FontSize="{DynamicResource MpMetaSize}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <!-- ChromeTextDim, not the reference's ChromeTextFaint: that
                                 is 3.30:1 on this row, under the 4.5:1 floor, and it is
                                 the same brush at the same ratio as the ELO beside it. -->
                            <TextBlock x:Name="ConnectionChipDetail"
                                       Margin="8,0,0,0"
                                       Foreground="{DynamicResource ChromeTextDim}"
                                       FontFamily="{DynamicResource BodyFont}"
                                       FontSize="{DynamicResource MpMetaSize}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Hidden with its neighbours rather than left floating: signed
                         out, both the capsule and the account block collapse, and a
                         divider alone in an empty row reads as a rendering glitch.
                         RefreshChromeDivider owns it. -->
                    <Rectangle x:Name="ChromeDivider"
                               Width="1" Height="20"
                               Visibility="Collapsed"
                               Fill="{DynamicResource ChromeRim}"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <!-- Account cluster. Replaces the Multiplayer tab's account ROW
                         (user | Sign out), one of the five stacked bars. Hidden until
                         multiplayer reports a signed-in user, so Library and Workshop
                         don't show an empty avatar before sign-in.

                         No chevron: the reference doesn't draw one. It is still a
                         button and still lifts on hover, which is the affordance. -->
                    <Button x:Name="AccountButton"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            Click="AccountButton_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Monogram disc. The photo, when there is one, is painted
                                 over it from code-behind so a failed download still
                                 leaves a readable initial underneath. -->
                            <Grid Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse x:Name="AccountAvatarEllipse" Fill="{DynamicResource MpAction}"/>
                                <TextBlock x:Name="AccountAvatarInitial"
                                           Foreground="#FFFFFF"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="AccountName"
                                           Foreground="{DynamicResource ChromeTextStrong}"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="{DynamicResource MpMetaSize}"
                                           FontWeight="SemiBold"/>
                                <!-- Collapses when the standing hasn't been fetched. The
                                     rating is pulled once per session from a
                                     rate-limited endpoint, so this reads that cache and
                                     never polls. -->
                                <!-- MpAccountElo, the token that exists for exactly this
                                     and that LobbyWindow's roster uses. The header rewrite
                                     swapped it for the reference's ChromeTextFaint, which
                                     is 3.30:1 at the app's smallest size — measured
                                     unreadable, and the third time that tone has been. -->
                                <TextBlock x:Name="AccountElo"
                                           Visibility="Collapsed"
                                           Margin="0,1,0,0"
                                           Foreground="{DynamicResource MpAccountElo}"
                                           FontFamily="{DynamicResource BodyFont}"
                                           FontSize="{DynamicResource MpMicroSize}"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- =============================================================
             Content area. Now full-width (no sidebar column eating
             240px). PlayView is the "cinema" dashboard. Other tabs
             (Workshop, Multiplayer, Settings) overlay on top when
             active.

             ClipToBounds guards the title-bar chrome above (Row 0):
             everything in this row — the full-bleed dashboard background
             image, the hero gradients, the scaled hero block — is clipped
             to the row so none of it can render up over the chrome. This is
             the safety net for the maximized full-bleed image reading as if
             it bleeds into the bar; it does NOT touch the chrome itself.

             The top border is what the deleted nav strip used to provide.
             That strip carried the only chrome/content divider, and it was
             shared by all three tabs — Multiplayer replaces it with its own
             sub-tab bar, but Library and Workshop have nothing, so without
             this line the title bar would bleed straight into their content.
             ============================================================= -->
        <Border Grid.Row="2">
        <Grid x:Name="ContentHost" ClipToBounds="True">

            <!-- ============================================================
                 PLAY VIEW — cinema dashboard.
                 Hero background image of active mod + dark gradient
                 overlays + bottom-anchored title/desc/PLAY/Settings/
                 ChangeMod row + progress strip.
                 All the legacy controls (ModsBar, HeroBanner, StatusCard,
                 ActionPanel, ProgressPanel, MainTabs) stay alive inside
                 LegacyPlayContent (Visibility=Collapsed) so the dozens
                 of code-behind references resolve and the install /
                 update / progress data still pumps through them. The
                 visible Dashboard buttons forward to those hidden
                 controls' click handlers.
                 ============================================================ -->
            <Grid x:Name="PlayView">

                <!-- Layer 1: the hero painted Stretch=Fill (the brush is
                     built in code in RefreshActiveMod) so it fills the whole
                     panel edge-to-edge with NO side bands and NO crop — at the
                     cost of distorting the hero's aspect ratio in a non-16:9
                     window. The maintainer picked stretch-to-fill over both
                     the old two-layer blurred-margin design (read as side
                     bands, "franjas") and a UniformToFill cover (disliked the
                     top/bottom crop). Fallback when no hero is a neutral dark
                     gradient, also set in RefreshActiveMod.
                     HighQuality scaling keeps 4K heroes crisp when decoded down.
                     DashboardBgFill is the BASE; DashboardBgFillB is the crossfade
                     overlay (opacity 0 at rest) for the rotating-hero feature —
                     ApplyDashboardHero owns both. Keep B right here, BEFORE the
                     dim gradients, or the overlay would cover the readability
                     scrims. -->
                <Border x:Name="DashboardBgFill"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Background="{DynamicResource BgPanelAlt}"/>
                <Border x:Name="DashboardBgFillB"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Opacity="0"/>

                <!-- Layer 2: vertical gradient — transparent at top,
                     opaque at bottom — so the title/desc/buttons at the
                     bottom-left stay readable on any hero image. -->
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#66000000" Offset="0.0"/>
                            <GradientStop Color="#22000000" Offset="0.40"/>
                            <GradientStop Color="#ee131313" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- Layer 2b: horizontal left-side dim so the title
                     reads even on bright images. -->
                <Rectangle IsHitTestVisible="False"
                           HorizontalAlignment="Left"
                           Width="640">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#cc000000" Offset="0.0"/>
                            <GradientStop Color="#00000000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- (Layer 3 removed — the top-right utility row with the
                     gear-cog Launcher Settings button and EN/ES language
                     toggles was retired per user request. Both flows are
                     still reachable from the title-bar brand menu
                     (🛡 AoE3 Mod Launcher ▼ → "Launcher settings"),
                     where the LauncherSettingsDialog hosts the language
                     combo too. The handlers stay in code-behind because
                     LauncherSettingsButton_Click is reused by the brand
                     menu wiring.) -->

                <!-- Layer 4: hero content — title, description, action
                     row, and the progress strip. Anchored bottom-left
                     so it sits over the dimmest part of the overlay.

                     The whole block is wrapped in HeroScaleTransform so it
                     auto-fits the resolution: 1:1 on a 1600x900-or-larger
                     screen and shrinking gently on anything smaller
                     (so the text isn't oversized on small laptops).
                     UpdateHeroScale() in code-behind divides the live
                     footprint by a FIXED ~1600x900 reference and drives
                     ScaleX/ScaleY off SizeChanged. RenderTransform
                     (not LayoutTransform) with RenderTransformOrigin="0,1"
                     pins the bottom-left corner so the block shrinks in
                     place over the dim corner of the hero image without
                     reflowing or nudging the layers behind it.

                     Text crispness: the global HiDPI setup renders all text
                     in TextFormattingMode=Display (pixel-snapped), which looks
                     crisp at 1:1 but BLURRY once a ScaleTransform shrinks it.
                     UpdateHeroScale() flips this subtree to Ideal + Animated
                     hinting whenever scale < 1.0 (smooth under transform) and
                     back to Display at exactly 1.0 (maximized) so the full-
                     size hero keeps its pixel-crisp look. -->
                <!-- Hero block. The window-size scale + bottom-left render-pin
                     are installed in code by UiScale.Attach(... Kind.Render,
                     origin 0,1) — see the constructor. Keep this subtree free of
                     a static RenderTransform so the scaler owns it. -->
                <Grid x:Name="HeroContentGrid"
                      Margin="48,0,48,32" VerticalAlignment="Bottom">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title + description block. Narrow column (was 900):
                         keeps the hero copy reading vertically instead of
                         sprawling across the panel, and lets multi-line
                         "Game: Subtitle" titles stack cleanly. -->
                    <!-- The scrim that replaces the two DropShadowEffects that used to sit
                         ON the title and the paragraph. An Effect on a TextBlock pushes its
                         glyphs through a composition pass and disables ClearType — measured
                         at 17.8 mean |R-B| on the paragraph's edges against 73 for chrome
                         text of the same family. The shadow was NOT decoration, though: this
                         copy sits over whatever hero image a mod ships, so it is replaced
                         rather than dropped. Sized off the block itself and blown outward by
                         a RenderTransform (no layout maths, and a transform on a Rectangle
                         costs nothing — there is no text under it). -->
                    <Rectangle Grid.Row="0" IsHitTestVisible="False"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5"
                               Width="{Binding ElementName=DashboardCopyBlock, Path=ActualWidth}"
                               Height="{Binding ElementName=DashboardCopyBlock, Path=ActualHeight}">
                        <Rectangle.RenderTransform>
                            <!-- Big on purpose. The gradient has to reach ZERO alpha before
                                 it reaches the Rectangle's own edge or the fill stops on a hard
                                 cut, which reads as a soft vertical seam across the hero image
                                 (it did, at the first attempt). Centre 0.5 + radius 0.5 puts the
                                 transparent stop exactly on the edge midpoints, so the scrim has
                                 to be roughly twice the copy block for its opaque core to still
                                 cover the text. -->
                            <ScaleTransform ScaleX="2.0" ScaleY="2.6"/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5"
                                                 RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#A6000000" Offset="0.0"/>
                                <GradientStop Color="#7A000000" Offset="0.45"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel x:Name="DashboardCopyBlock" Grid.Row="0" MaxWidth="640" HorizontalAlignment="Left">
                        <!-- Mod/game icon (catalog icon.png or built-in packed
                             icon). Filled + shown by RefreshActiveModBanner;
                             collapsed when the active mod has no icon. -->
                        <Border x:Name="DashboardIconHost"
                                Width="64" Height="64"
                                CornerRadius="{StaticResource RadiusLg}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14"
                                Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="Black" Opacity="0.6"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock x:Name="DashboardTitleText"
                                   FontFamily="{DynamicResource DisplayFont}"
                                   FontSize="48"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   LineHeight="56"
                                   LineStackingStrategy="BlockLineHeight"
                                   TextWrapping="Wrap"/>
                        <!-- Version chip — installed-version of the active
                             mod. Painted in the green Status-Installed
                             palette (same as the Catalog "Installed"
                             badge) so the colour itself reads as "you
                             have this version on disk, everything's
                             healthy" — green = good, like the rest of
                             the app's status badges. Hidden by code-
                             behind when no version is known (fresh
                             machine before CheckAsync ran, or for mods
                             that haven't been installed yet). -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0">
                            <Border x:Name="DashboardVersionChip"
                                    Padding="10,3"
                                    VerticalAlignment="Center"
                                    CornerRadius="{StaticResource RadiusLg}"
                                    BorderBrush="{DynamicResource StatusInstalledFg}"
                                    BorderThickness="1"
                                    Background="{DynamicResource StatusInstalledBg}"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="DashboardVersionText"
                                           FontFamily="{DynamicResource DisplayFont}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource StatusInstalledFg}"/>
                            </Border>
                            <!-- Active-copy chip: only visible when the mod has 2+ installed
                                 copies (HasMultipleInstalls). Shows the active copy's real
                                 FOLDER name so the user always knows which copy they'll play;
                                 clicking it opens the same copy switcher as the MODS button
                                 (reuses DashboardChangeModButton_Click, anchored to this chip). -->
                            <Button x:Name="DashboardCopyChip"
                                    Style="{StaticResource DashboardSecondaryButton}"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Padding="10,3"
                                    Background="{DynamicResource TintGoldHover}"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="1"
                                    Visibility="Collapsed"
                                    Click="DashboardChangeModButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock x:Name="DashboardCopyText"
                                               FontFamily="{DynamicResource DisplayFont}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="260"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <!-- Description copy: SecondaryFixed (#d2e4fb)
                             — bright cool body tone so the paragraph
                             reads against the dim hero background
                             without competing with the dorado title. -->
                        <TextBlock x:Name="DashboardDescText"
                                   FontFamily="{DynamicResource BodyFont}"
                                   FontSize="14"
                                   Foreground="{DynamicResource SecondaryFixed}"
                                   LineHeight="22"
                                   TextWrapping="Wrap"
                                   MaxWidth="780"
                                   Margin="0,14,0,0"/>
                    </StackPanel>

                    <!-- Action row: PLAY (gold gradient + glow) +
                         settings gear + change mod. -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,28,0,0">
                        <Button x:Name="DashboardPlayButton"
                                Style="{StaticResource SidebarPrimaryButton}"
                                MinWidth="220"
                                Padding="34,16"
                                Click="DashboardPlayButton_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE768;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="20"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="DashboardPlayButtonText"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="18"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DashboardSettingsButton"
                                Style="{StaticResource DashboardSecondaryButton}"
                                Width="64"
                                Margin="14,0,0,0"
                                Padding="0"
                                Click="DashboardSettingsButton_Click">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="22"
                                       HorizontalAlignment="Center"/>
                        </Button>
                        <Button x:Name="DashboardChangeModButton"
                                Style="{StaticResource DashboardSecondaryButton}"
                                Margin="14,0,0,0"
                                Padding="22,0"
                                Click="DashboardChangeModButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="DashboardChangeModButtonText"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource DisplayFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <!-- Shown only when an isolated-folder mod (WoL) reads as
                             NOT installed: lets a user who already has it point the
                             launcher at it instead of re-downloading via Install.
                             Collapsed by default; ApplyCheckResult toggles it. -->
                        <Button x:Name="DashboardSearchInstallButton"
                                Style="{StaticResource DashboardSecondaryButton}"
                                Margin="14,0,0,0"
                                Padding="22,0"
                                Visibility="Collapsed"
                                Click="DashboardSearchInstallButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="18"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="DashboardSearchInstallButtonText"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource DisplayFont}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Progress strip. Always visible; the label flips
                         between "Ready for operations" (idle) and the
                         live update label (running). Speed/Eta/Pct cells
                         show "—" when idle.
                         Capped at MaxWidth so the bar doesn't stretch
                         the full hero width — the HTML mock has a much
                         tighter progress footprint that lives next to
                         the bottom-left content column, not flush to
                         the right edge of the panel. -->
                    <StackPanel Grid.Row="2"
                                x:Name="DashboardProgressContainer"
                                HorizontalAlignment="Left"
                                MaxWidth="860"
                                Margin="0,28,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <!-- Pause / Cancel column. Only visible
                                     while an op is running; the
                                     SyncDashboardProgressFromLegacyPanel
                                     pump flips its visibility from the
                                     legacy ProgressRunningActions row. -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="DashboardProgressIcon"
                                               Text="&#xE73E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock x:Name="DashboardProgressLabel"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontFamily="{DynamicResource DisplayFont}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Cool secondary tone for the subtitle "Listo
                                     para operaciones / Descargando…" so the
                                     bigger gold label above carries the
                                     visual weight. -->
                                <TextBlock x:Name="DashboardProgressSubtitle"
                                           Foreground="{DynamicResource OnSecondaryContainer}"
                                           FontSize="11"
                                           Margin="22,2,0,0"/>
                            </StackPanel>
                            <!-- Column-header microtype labels switch to the
                                 cool Secondary tone so they read as quiet
                                 metadata. Data values stay dorado so the
                                 user's eye locks onto the actual numbers. -->
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="VELOCIDAD"
                                           Foreground="{DynamicResource Secondary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <!-- Data values use SecondaryFixed (cool
                                     bright blue-white) so progress reads
                                     as informational metadata. Dorado is
                                     reserved for the main progress label
                                     + the indicator bar. -->
                                <TextBlock x:Name="DashboardProgressSpeed"
                                           Foreground="{DynamicResource SecondaryFixed}"
                                           FontSize="13"
                                           Text="—"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="14,0,0,0">
                                <TextBlock Text="TIEMPO RESTANTE"
                                           Foreground="{DynamicResource Secondary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="DashboardProgressEta"
                                           Foreground="{DynamicResource SecondaryFixed}"
                                           FontSize="13"
                                           Text="—"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Margin="14,0,0,0">
                                <TextBlock Text="PROGRESO"
                                           Foreground="{DynamicResource Secondary}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="DashboardProgressPercent"
                                           Foreground="{DynamicResource SecondaryFixed}"
                                           FontSize="13"
                                           Text="—"/>
                            </StackPanel>

                            <!-- Pause + Cancel for the currently running
                                 operation. Hidden in idle state; visible
                                 only when ProgressRunningActions on the
                                 legacy panel is visible. Clicks are
                                 forwarded to the legacy buttons so the
                                 existing pause/resume/cancel logic in
                                 PauseButton_Click / CancelButton_Click
                                 keeps owning the decisions. -->
                            <StackPanel Grid.Column="4"
                                        x:Name="DashboardProgressActions"
                                        Orientation="Horizontal"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <Button x:Name="DashboardPauseButton"
                                        Style="{StaticResource DashboardSecondaryButton}"
                                        Width="36" Height="36"
                                        Padding="0"
                                        Click="DashboardPauseButton_Click">
                                    <TextBlock x:Name="DashboardPauseButtonIcon"
                                               Text="&#xE769;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="DashboardCancelButton"
                                        Style="{StaticResource DashboardSecondaryButton}"
                                        Width="36" Height="36"
                                        Padding="0"
                                        Margin="8,0,0,0"
                                        Click="DashboardCancelButton_Click">
                                    <TextBlock Text="&#xE711;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ProgressBar x:Name="DashboardProgressBar"
                                     Style="{StaticResource ShimmerProgressBar}"
                                     Height="4"
                                     Value="0"/>
                    </StackPanel>
                </Grid>

                <!-- LEGACY COMPAT: hidden but tree-attached so the
                     existing code-behind keeps working (RefreshActiveMod,
                     RefreshActionPanel, RefreshStatusCard, all the
                     MainTabs handlers, etc.). The visible Dashboard
                     above mirrors data from these on Refresh*. -->
                <Grid x:Name="LegacyPlayContent" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ModsBarLabel"/>
                        <StackPanel x:Name="ModCardsPanel" Orientation="Horizontal"/>
                        <controls:HeroBanner x:Name="ActiveModBanner"/>
                        <controls:StatusCard x:Name="StatusCardControl"/>
                        <controls:ActionPanel x:Name="ActionPanelControl"/>
                        <controls:ProgressPanel x:Name="ProgressPanelControl"/>
                        <controls:MainTabs x:Name="MainTabsControl"/>
                        <Border x:Name="ProgressOverlay" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Grid>   <!-- /PlayView -->

            <!-- v0.9 mod browser — appears overlaying the cinema dashboard
                 when CATALOG is active in the sidebar. -->
            <controls:ModsBrowser x:Name="ModsBrowserView" Visibility="Collapsed"/>

            <!-- v1.0 multiplayer lobby. -->
            <controls:MultiplayerTab x:Name="MultiplayerView" Visibility="Collapsed"/>

            <!-- Settings tab placeholder. -->
            <Grid x:Name="SettingsView" Visibility="Collapsed"
                  Background="{DynamicResource BgBase}">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="500">
                    <TextBlock x:Name="SettingsTeaserText"
                               Foreground="{DynamicResource TextPrimary}"
                               FontSize="{DynamicResource FontSizeBodyStrong}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>
                    <Button x:Name="OpenSettingsTabButton"
                            Style="{StaticResource SidebarPrimaryButton}"
                            HorizontalAlignment="Center"
                            MinWidth="200"
                            Click="OpenSettingsTabButton_Click"/>
                </StackPanel>
            </Grid>

        </Grid>   <!-- /Content host -->
        </Border> <!-- /chrome-to-content divider -->

        <!-- In-app toast notifications (AppToast): non-modal, stacked, auto-dismiss
             cards in the bottom-right that float over ANY tab. Spans all rows;
             Background is null so it only intercepts clicks on the cards themselves
             (empty areas stay click-through to the content below). -->
        <StackPanel x:Name="ToastHost"
                    Grid.Row="0" Grid.RowSpan="3"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Margin="0,0,16,16"
                    Background="{x:Null}"
                    IsHitTestVisible="True"/>

        <!-- Hidden compatibility shim. The old layout had an "AoE3PathRow" that
             code-behind sometimes referenced; the new design folds that info
             into the game footer, so this is just a placeholder so the existing
             references keep compiling. -->
        <StackPanel x:Name="AoE3PathRow" Visibility="Collapsed"/>
        <TextBlock x:Name="InstallPathText" Visibility="Collapsed"/>
        <TextBlock x:Name="LblModPath" Visibility="Collapsed"/>

        <!-- System-tray icon. Hidden by default; the code-behind shows it
             when the user has "Minimize to tray on close" enabled and they
             close the main window. Double-click the tray icon to restore;
             right-click to get a tiny context menu (Show / Exit). The
             icon resource is pack://-loaded so it survives single-file
             publish. -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="pack://application:,,,/AppIcon.ico"
                        Visibility="Collapsed"
                        TrayLeftMouseUp="TrayIcon_LeftClick"
                        TrayMouseDoubleClick="TrayIcon_DoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="TrayMenuShow" Click="TrayMenuShow_Click"/>
                    <Separator/>
                    <MenuItem x:Name="TrayMenuExit" Click="TrayMenuExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</Window>
