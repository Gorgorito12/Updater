<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         GEOMETRY SCALE — semantic spacing / radius / icon-disc /
         button-padding tokens. Same idea + rules as the FontSize scale
         in App.xaml: one knob per role, StaticResource (app-lifetime
         constants), consumed by Buttons.xaml / Inputs.xaml and every
         Controls/*.xaml. New UI binds to a token; it must not hardcode
         a literal size.

         WHY A SEPARATE DICTIONARY MERGED FIRST (not inline in App.xaml):
         a `{StaticResource}` used INSIDE a ControlTemplate body in a
         merged dictionary (Buttons/Inputs) can only resolve resources in
         dictionaries merged BEFORE it — NOT App.xaml's inline resources
         (those are added after the MergedDictionaries block, so a
         template-body lookup never sees them and throws "resource not
         found" at load). The FontSize tokens get away with living inline
         because they're only referenced from Setters (deferred) + direct
         element attributes, never from a merged-dictionary template body.
         These geometry tokens ARE referenced from template bodies (button
         + input corner radii), so they must live here and be merged ahead
         of Buttons.xaml / Inputs.xaml. (Same reason Colors.xaml is merged
         first — its brushes resolve inside those templates too.)

         The window-size scaler (Controls/UiScale.cs) scales the RENDER via
         a transform, not these token VALUES, so StaticResource stays
         correct. Load-bearing exemptions that deliberately stay literal:
         the two-tone popup-rim radii (kept here as a paired set, outer =
         inner + 1, NOT folded into the Radius scale), the gold brand-popup
         rim, the hero subtree, Segoe MDL2 glyph / monogram sizes, and the
         intentional fixed widths (chat 380, lobby left 340, hero icon 64).
         See CLAUDE.md before changing any of those.
         ============================================================ -->

    <!-- Spacing (Thickness). 4px base grid. CardPadding is the dominant
         existing card padding (kept at 14,12 to avoid drift);
         SectionPadding is the header gutter. -->
    <Thickness x:Key="SpaceXs">4</Thickness>
    <Thickness x:Key="SpaceSm">8</Thickness>
    <Thickness x:Key="SpaceMd">12</Thickness>
    <Thickness x:Key="SpaceLg">16</Thickness>
    <Thickness x:Key="SpaceXl">24</Thickness>
    <Thickness x:Key="CardPadding">14,12</Thickness>
    <Thickness x:Key="SectionPadding">24,16</Thickness>

    <!-- Corner radius (CornerRadius). Sm = buttons/inputs/badges,
         Md = cards/panels/info boxes, Lg = prominent tiles. -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>
    <!-- Extension of the scale for the multiplayer redesign (design handoff
         1a/1d/1e/1f). Its radius ladder is finer than Sm/Md/Lg: controls and
         fields at 7, rows and boxes at 8, panels at 9, and a full pill for
         chips. Named by ROLE rather than by size so a later retune moves every
         control together instead of hunting literals. -->
    <CornerRadius x:Key="RadiusControl">7</CornerRadius>
    <CornerRadius x:Key="RadiusRow">8</CornerRadius>
    <CornerRadius x:Key="RadiusPanel">9</CornerRadius>
    <!-- Pill = HALF the control's height, NOT a huge number. The handoff writes
         `border-radius: 999px`, which is a CSS idiom: browsers clamp it to 50%. WPF
         does NOT clamp — it builds the geometry from the value as given, the corner
         arcs overlap, and the Border renders as a distorted ellipse that swallows its
         own content. This value therefore only fits a 26px-high control (the
         connection chip); a pill of another height needs its own half-height radius. -->
    <CornerRadius x:Key="RadiusPill">13</CornerRadius>

    <!-- Two-tone "punched-out" popup rim — NOT part of the scale. Outer
         MUST stay inner+1 (the 1px near-black band over the 2px bright
         inner line). See the popup-rim gotcha in CLAUDE.md. -->
    <CornerRadius x:Key="RadiusPopupInner">6</CornerRadius>
    <CornerRadius x:Key="RadiusPopupOuter">7</CornerRadius>
    <CornerRadius x:Key="RadiusPopupSubmenuInner">4</CornerRadius>
    <CornerRadius x:Key="RadiusPopupSubmenuOuter">5</CornerRadius>

    <!-- Icon-disc sizes (sys:Double for Width/Height) + paired radii
         (CornerRadius = size/2). Use the IconDisc* Border styles in
         Buttons.xaml so the radius can't drift from the size. Only for
         CIRCULAR discs — rounded squares (the 64px hero icon host) use a
         Radius* token instead. -->
    <sys:Double x:Key="DiscSizeSm">24</sys:Double>
    <sys:Double x:Key="DiscSizeMd">36</sys:Double>
    <sys:Double x:Key="DiscSizeXxl">72</sys:Double>
    <CornerRadius x:Key="DiscRadiusSm">12</CornerRadius>
    <CornerRadius x:Key="DiscRadiusMd">18</CornerRadius>
    <CornerRadius x:Key="DiscRadiusXxl">36</CornerRadius>

    <!-- Button padding (Thickness). The default family normalises the old
         7/8/9 vertical values to 8. -->
    <Thickness x:Key="BtnPadCompact">10,5</Thickness>
    <Thickness x:Key="BtnPadDefault">14,8</Thickness>
    <Thickness x:Key="BtnPadRow">14,10</Thickness>
    <Thickness x:Key="BtnPadRoomy">18,8</Thickness>
    <Thickness x:Key="BtnPadCta">14,14</Thickness>

    <!-- ============================================================
         TITLE BAR — the SINGLE source of truth for the global custom
         window chrome bar (Controls/TitleBar). Every window's title bar
         height, its WindowChrome CaptionHeight (set centrally in
         App.OnAnyWindowLoaded), and the min/max/close button geometry all
         read these. Don't hardcode a bar height or button size anywhere
         else — change it here once and every window follows.
         ============================================================ -->
    <!-- Bar height for SECONDARY windows (every dialog / popup / lobby / settings
         sheet). Slim 28px caption — the title now shrinks to fit the bar, NOT the
         other way around (the old "bar grows to hold a 24px title" rule is gone;
         see TitleBarTitleSize). 28 is DPI-clean: 28×1.25=35, 28×1.5=42 (whole
         pixels, no sub-pixel blur). Single global knob for the secondaries — every
         such window's bar follows it; never hardcode a height per window. The MAIN
         launcher header is the deliberate EXCEPTION and reads TitleBarHeightMain
         below. WindowChrome.CaptionHeight is matched per-window in
         App.ApplyWindowChrome (this token for secondaries, TitleBarHeightMain for
         MainWindow) so the whole bar stays the native drag/double-click region. -->
    <sys:Double x:Key="TitleBarHeight">28</sys:Double>
    <!-- Main launcher header height — the ONLY window off the slim secondary bar.
         MainWindow opts into this explicitly (Height + its CaptionHeight both read it)
         so the compact secondary bar never shrinks the main header.

         36 (was 46): the tabs moved back OUT of the bar into their own nav row
         (MainNavHeight below), leaving the title bar with just the brand, the version
         chip and the three chrome affordances beside the caption buttons.

         THIS TOKEN IS THE ONLY PLACE THAT HEIGHT MAY BE SET, and with two chrome rows
         it is load-bearing in a second way: App.ApplyWindowChrome reads it to set
         WindowChrome.CaptionHeight, and the caption region is *defined* as "the top N
         DIPs" — WindowChrome only consults IsHitTestVisibleInChrome inside it. Leave
         this at 46 while the bar renders at 36 and the top 10px of the NAV row stays
         caption: every tab would drag the window instead of switching tabs along its
         upper edge. No compile error, nothing visible to hint at it.

         36 is DPI-clean where 46 was not: ×1.25 = 45, ×1.5 = 54, whole pixels both. -->
    <sys:Double x:Key="TitleBarHeightMain">36</sys:Double>
    <!-- Nav row height — the strip under the title bar carrying the three main tabs and
         the player's status. MainWindow only; it is a plain content row, NOT part of the
         caption region, which is exactly why it gets its own knob instead of extending
         TitleBarHeightMain: growing that token would hand the nav row's top edge to the
         window-drag handler (see above).

         54 is the reference's value and is not DPI-clean at 125% (×1.25 = 67.5). The
         global UseLayoutRounding absorbs it, but the half pixel lands on the row's
         BOTTOM edge — where the 1px rule and the active tab's 2px underline sit — so 56
         (70 / 84) is the nearest clean value if either ever looks fuzzy on a real 125%
         display. -->
    <sys:Double x:Key="MainNavHeight">54</sys:Double>
    <!-- Caption-button footprint. Width 40 (down from the classic 46) to match the
         slimmer bar; height fills the bar so they read as one strip. 40 is DPI-clean
         (×1.25=50, ×1.5=60). The main header overrides back to 46 locally. -->
    <sys:Double x:Key="TitleBarButtonWidth">40</sys:Double>
    <!-- Segoe MDL2 glyph size for the min/max/restore/close icons — 8 to stay
         proportionate to the 28px bar (main header overrides back to 10). -->
    <sys:Double x:Key="TitleBarGlyphSize">8</sys:Double>
    <!-- Title text size — sized to sit centred in the 28px bar without clipping
         (gold DisplayFont). 16 (down from 24): the bar is the fixed dimension now
         and the title fits IT, the inverse of the old rule. Its OWN knob, still
         independent of TitleBarHeight. -->
    <sys:Double x:Key="TitleBarTitleSize">16</sys:Double>
    <!-- Left gutter before the icon/title; right side is flush with the
         buttons. -->
    <Thickness x:Key="TitleBarContentPadding">12,0,8,0</Thickness>

    <!-- MainWindow header geometry (the two-row reference). Side gutter of the nav
         row; the version chip beside the wordmark; the connection capsule's radius.

         The two radii are tokens rather than literals for the reason the house rule
         gives: a pill in WPF needs an EXPLICIT half-height radius, because CSS's
         `border-radius: 999px` is a clamped-to-50% idiom that WPF renders as a
         distorted ellipse. RadiusPill (13) belongs to the 26px chips elsewhere and is
         wrong for a 30px capsule. -->
    <Thickness x:Key="MainNavPadding">20,0</Thickness>
    <sys:Double x:Key="ChromeVersionSize">11</sys:Double>
    <CornerRadius x:Key="ChromeVersionRadius">3</CornerRadius>
    <sys:Double x:Key="ChromeCapsuleHeight">30</sys:Double>
    <CornerRadius x:Key="ChromeCapsuleRadius">15</CornerRadius>

    <!-- ============================================================
         SIDEBAR NAV RAIL — the settings/properties dialogs' left tab rail
         (SidebarNavButton). The rail column is `Width="Auto"` clamped to this
         [min,max] so it sizes to the WIDEST nav item (icon + text + padding +
         active stripe) instead of a hardcoded 200px that clipped long labels
         like "CATÁLOGO DE MODS". Min keeps the prior visual footprint; max
         stops a freakishly long label from eating the content area (the label
         then ellipsises via SidebarNavLabel). Single source — both dialogs
         read these, no per-dialog literal.
         ============================================================ -->
    <sys:Double x:Key="SidebarRailMinWidth">200</sys:Double>
    <sys:Double x:Key="SidebarRailMaxWidth">340</sys:Double>
    <!-- Nav-item text size (SidebarNavLabel). Its OWN knob, independent of the
         normal body text (FontSizeBody) and of the rail width: the rail grows
         to fit this, the text is never shrunk to fit the rail. 16 = the size
         the SidebarNavButton style was already designed around. -->
    <sys:Double x:Key="SidebarNavTextSize">16</sys:Double>

    <!-- MainWindow top-tab text size (NavTabButton: LIBRARY/WORKSHOP/
         MULTIPLAYER). Its OWN knob, independent of the title and the dialog-rail
         nav.

         13, the new header reference's value. It was briefly MpLabelSize (11.5) while
         the tabs lived INSIDE the title bar, where they had to fit a 46px strip beside
         everything else. Back in a row of their own they fit the type scale's
         documented floor again — so this is one deviation that closed itself. -->
    <sys:Double x:Key="NavTabTextSize">13</sys:Double>

    <!-- ============================================================
         MULTIPLAYER REDESIGN GEOMETRY (design handoff 1a/1d/1e/1f —
         docs/design_handoff_multiplayer_ui/README.md, "Alturas").

         The main title bar's own height is NOT here: it stays
         TitleBarHeightMain above, because WindowChrome.CaptionHeight is
         derived from that same token in App.ApplyWindowChrome. Giving the
         bar a second height knob is precisely how the visual bar and the
         native drag region drift apart — and that failure is silent: no
         compile error, no visual clue, the bottom strip of the bar just
         stops dragging the window.
         ============================================================ -->
    <!-- The multiplayer sub-tab strip (Salas / Amigos / Perfil / Historial). -->
    <sys:Double x:Key="MpSubBarHeight">48</sys:Double>
    <!-- Room row. A MINIMUM, not a fixed height — MpRoomCard binds it to MinHeight.
         It was uniform by contract ("the row is ONE line with ellipsis, so its height must
         not depend on the content"), and that reading survived until the type sizes went to
         the 13 floor: the room NAME then truncated to "Sala de W…" in a narrow window,
         because it is the only element in that cell that yields. The name may wrap to a
         second line, so short rows measure exactly this and long ones grow past it.

         Back to 58, because it only ever went to 64 to carry the raised type sizes and
         those have been reverted (see the block below). The MinHeight semantics and the
         wrapping name STAY: that was fixed for a reason of its own — a long name in a
         narrow window — which the type size never governed. -->
    <sys:Double x:Key="MpRoomRowHeight">58</sys:Double>
    <!-- Controls. Field = search / chat composer; FieldTall = a dialog's main
         text input; Control = a normal button; PrimaryButton = the one CTA. -->

    <!-- ===================================================================
         MULTIPLAYER TYPE SIZES — the design handoff's own values.

         THE HISTORY MATTERS, because this is the FOURTH turn on the same six numbers
         and the third reversal. These sizes came from the handoff (11.5 labels, 10.5
         pills, 9.5 section captions) and sit BELOW the app-wide type scale's floor of
         13 — a floor that exists because 10-11 px secondary text was reported unreadable
         at 125/150% scaling. Raising them was proposed and DECLINED TWICE on the
         maintainer's explicit call for fidelity to the reference; asked a third time from
         the other direction ("still looks small", about the shipped surface) it was
         granted, and they went to 13.

         They are back at the reference's values, and THE ARGUMENT IS WHAT CHANGED, not
         the taste. Every earlier round was forced to answer "the text is too small" by
         moving these tokens, because moving them was the only lever there was: the
         re-coloured text ramp had already been spent (see .claude/rules/multiplayer.md),
         and magnifying the whole surface through UiScale was rejected on sight as
         "gigante" (see CLAUDE.md's UiScale bullet) — it scales the padding too, so it is
         a zoom rather than bigger type.

         The lever that did not exist then is Services/TextScale.cs: a launcher-wide
         "text size" setting (100 / 110 / 125 % / Automatic) that multiplies every size
         token and NOTHING else — no transform, no padding, ClearType intact. So the
         reference's proportions come back for everyone and the legibility is bought where
         it belongs, by anybody who wants it.

         THE SETTING DEFAULTS TO AUTOMATIC, and that went round twice — both turns are worth
         keeping, because each one is right about something. Automatic puts a 32" 1440p desktop
         at 115 %, which is 11.5 x 1.15 = 13.2: it silently raised these six numbers straight
         back to where the revert had just taken them from, so the default was moved to 100 on
         the reasoning that a default which undoes the change it exists to enable is not a
         default.

         That lasted one round. The curve only ever RAISES, so a default of 100 leaves the
         SMALL screens on the smallest type in the launcher — 11.5 px labels and 9.5 px
         captions, which is the size the block above calls unreadable at 125/150 % scaling.
         Between a large monitor showing more than the reference asks for and a laptop showing
         less than anyone can read, the second is the worse failure. So: these tokens ARE the
         reference, and Automatic decides what a given screen does with them.

         AND THEN THE CURVE ITSELF CAME DOWN A STEP, which is the only part of this argument
         that was ever settled by looking. 115 % was derived to put a 32" back at the size it
         had shown before the revert; shipped to that machine, 13.2 px read as too big. The
         29-34" band is 110 % now (11.5 x 1.10 = 12.65) and the band above it 120 %. So these
         six numbers are still the reference, and what a large screen adds to them is smaller
         than the arithmetic said it should be.

         Still their own tokens, for the original reason: reversing this is six numbers,
         and they cannot leak into the app-wide scale.
         =================================================================== -->
    <sys:Double x:Key="MpLabelSize">11.5</sys:Double>
    <sys:Double x:Key="MpBodySize">12.5</sys:Double>
    <sys:Double x:Key="MpMetaSize">12</sys:Double>
    <sys:Double x:Key="MpPillSize">10.5</sys:Double>
    <sys:Double x:Key="MpMicroSize">10</sys:Double>
    <!-- The uppercase stat captions in the room header, and the values under them. The
         caption is the smallest thing on the surface because it is letter-spaced
         uppercase, which reads a size larger than it measures. -->
    <sys:Double x:Key="MpSectionLabelSize">9.5</sys:Double>
    <sys:Double x:Key="MpStatValueSize">14</sys:Double>
    <!-- The room name in the lobby header: serif, the one display-type moment in
         this window. -->
    <sys:Double x:Key="MpRoomNameSize">16</sys:Double>
    <!-- The end-of-match card's two display sizes: the verdict, and the new rating in
         monospace beside it. Both are one-of-a-kind moments, which is why they sit above
         the rest of the multiplayer scale rather than inside it. -->
    <sys:Double x:Key="MpResultTitleSize">17</sys:Double>
    <sys:Double x:Key="MpRatingSize">22</sys:Double>
    <!-- The community-activity strip, and ONLY it. Its own three sizes because it went to
         the type scale's 13 floor on a call of its own, EARLIER than the rest of the tab
         and separately from it — and it is the one part whose size nobody has ever
         complained about, which is why it became the anchor when the rest was briefly
         raised to match.

         IT IS DELIBERATELY NOT REVERTED with the block above. 11.5/13 ARE its original
         values; taking them down to the handoff's would not be undoing that raise, it
         would be a new change to a surface that never asked for one. Separate tokens so
         the two decisions stay separable — which is exactly what let this one stay put. -->
    <sys:Double x:Key="MpActivityTitleSize">11.5</sys:Double>
    <sys:Double x:Key="MpActivityBodySize">13</sys:Double>
    <sys:Double x:Key="MpActivityHeadlineSize">16</sys:Double>
    <!-- ===================================================================
         CLASIFICACION / HISTORIAL / PERFIL (design handoff 3a/3b/3c).

         Five display sizes that exist nowhere else in the tab, kept apart from the scale
         above for the same reason MpResultTitleSize is: they are one-of-a-kind moments,
         not rungs anybody should reach for by default. All five scale with the text-size
         setting — they are listed in TextScale.ScaledKeys.
         =================================================================== -->
    <!-- The page title on Clasificacion and Historial. Serif, 17/700. -->
    <sys:Double x:Key="MpPageTitleSize">17</sys:Double>
    <!-- The profile header: the player's name, and the rating as the one number the page
         is built around. Both serif. -->
    <sys:Double x:Key="MpProfileNameSize">20</sys:Double>
    <sys:Double x:Key="MpProfileRatingSize">30</sys:Double>
    <!-- The W-L record on the profile, in monospace so the two numbers line up. -->
    <sys:Double x:Key="MpProfileRecordSize">20</sys:Double>
    <!-- A history card's rating delta — the thing you actually read the card for, which is
         why it is the largest type on it. Monospace. -->
    <sys:Double x:Key="MpHistoryDeltaSize">17</sys:Double>

    <!-- ===================================================================
         TORNEOS / ESTADISTICAS (design handoff 8a-8c / 9a-9b).

         Four rungs the multiplayer scale did not have. Everything else these two screens
         need was already here - 9.5 MpSectionLabelSize, 10 MpMicroSize, 10.5 MpPillSize,
         11.5 MpLabelSize, 12 MpMetaSize, 12.5 MpBodySize - and is reused rather than
         duplicated.

         All four are in TextScale.ScaledKeys. A size declared here and forgotten there
         does not fail the build and does not throw: that one piece of text silently stops
         scaling, and TextScaleTests is the only thing that notices.

         They are Mp* and not Set*/Ws* even where one of those families already holds the
         same number, because pointing one family at another chains two unrelated surfaces
         together: a dial turned for Ajustes would move the bracket.
         =================================================================== -->
    <!-- The tag glued to a name: a map's pack (ESOC), a bracket card's PASA, the TU and
         MIO markers. The smallest type either screen uses, and it can be, because it is
         always letter-spaced uppercase inside a chip. -->
    <sys:Double x:Key="MpTagSize">9</sys:Double>
    <!-- Every FIGURE in a table or a bracket card: seeds, counts, percentages, places,
         rounds. Monospace, and a rung above the tag because a number meant to be compared
         down a column cannot be the smallest thing on the screen. -->
    <sys:Double x:Key="MpFigureSize">11</sys:Double>
    <!-- The three headline numbers of TUS NUMEROS on Estadisticas: rating, decided, win
         rate. Monospace. Deliberately below MpRoomNameSize - they are a summary, not the
         one number a whole page is built around. -->
    <sys:Double x:Key="MpFigureHeadlineSize">15</sys:Double>
    <!-- A tournament's own name, serif, at the head of its detail pane. Larger than
         MpPageTitleSize because it is not the page's title: the page is "Torneos" and this
         says which tournament you opened. -->
    <sys:Double x:Key="MpTournamentNameSize">19</sys:Double>

    <!-- ===================================================================
         WORKSHOP TYPE SIZES.

         The Workshop ran on the app-wide scale (13 / 14 / 15 / 24) while the multiplayer
         surface next door ran on its own, a size and a half smaller. Side by side they read
         as two applications, which is what this closes.

         THEY DUPLICATE THE Mp* VALUES ON PURPOSE — do not "simplify" them into those tokens.
         It is the same call MpActivity*Size already documents a few lines up: these are
         separate decisions about separate surfaces, and pointing one at the other's token
         chains them together so the next person who tunes the multiplayer scale moves the
         Workshop without knowing it. Reversing this is four numbers, which is the point.
         Pinned by TextScaleTests.
         =================================================================== -->
    <sys:Double x:Key="WsHeadingSize">17</sys:Double>
    <sys:Double x:Key="WsBodyStrongSize">12.5</sys:Double>
    <sys:Double x:Key="WsBodySize">12</sys:Double>
    <sys:Double x:Key="WsLabelSize">11.5</sys:Double>
    <!-- The mono meta line under a Workshop row, and the status badge on its right.
         Same two numbers the settings windows use (SetMonoSize / SetBadgeSize), spelled
         out here for the same reason as the four above: separate surface, separate dial. -->
    <sys:Double x:Key="WsMonoSize">11</sys:Double>
    <sys:Double x:Key="WsBadgeSize">9</sys:Double>

    <sys:Double x:Key="MpFieldHeight">34</sys:Double>
    <sys:Double x:Key="MpFieldHeightTall">40</sys:Double>
    <sys:Double x:Key="MpControlHeight">30</sys:Double>
    <sys:Double x:Key="MpPrimaryButtonHeight">42</sys:Double>


    <!-- ===================================================================
         SETTINGS-SURFACE TYPE SIZES (Set*).

         The third size family, after Mp* and Ws*. It dresses the two settings
         windows (LauncherSettingsDialog, ModPropertiesDialog) and comes from
         docs/design_handoff_ajustes_y_taller — every value is the handoff's own.

         THEY DUPLICATE Mp*/Ws* VALUES ON PURPOSE — do not alias them into those
         tokens. Same call Ws* documents right below: separate decisions about
         separate surfaces, and pointing one at another chains them so the next
         person tuning multiplayer moves Settings without knowing. Pinned by
         TextScaleTests.

         Consume them as {DynamicResource}: a {StaticResource} font size is
         resolved at parse time and silently stops following the launcher-wide
         Text size setting (Services/TextScale.cs).
         =================================================================== -->
    <sys:Double x:Key="SetSectionTitleSize">17</sys:Double>   <!-- "General" / "Avanzado", serif -->
    <sys:Double x:Key="SetBodySize">12.5</sys:Double>         <!-- setting-row title, nav entry -->
    <sys:Double x:Key="SetControlSize">12</sys:Double>        <!-- footer buttons, combo value -->
    <sys:Double x:Key="SetDescSize">11.5</sys:Double>         <!-- row description, action button -->
    <sys:Double x:Key="SetMonoSize">11</sys:Double>           <!-- paths, versions, sizes, hashes -->
    <sys:Double x:Key="SetGroupLabelSize">10.5</sys:Double>   <!-- INICIO / AVISOS, sidebar footer -->
    <sys:Double x:Key="SetTinySize">9.5</sys:Double>          <!-- nav count pill -->
    <sys:Double x:Key="SetBadgeSize">9</sys:Double>           <!-- RECOMENDADO, status labels -->

    <!-- ===================================================================
         SETTINGS-SURFACE GEOMETRY.

         THE CONTENT COLUMN IS NOT CAPPED. A settings section spans the whole window,
         and the absence of a cap is deliberate rather than an oversight: four shapes
         have been tried and the first three were each rejected on sight — capped and
         pinned LEFT (half a maximised 2560 monitor blank), the same cap CENTRED (the
         emptiness moved into two quarters), and a split into COLUMNS, which on a wide
         window drew two unequal columns with half a panel blank underneath. So there
         is no SetColumnMinWidth / MaxWidth / Gutter any more, and Controls/CardColumns.cs
         is gone with them.

         What the cap was protecting is real, and it moved to the one place that needs
         it. SetRowTitle and SetGroupLabel TRIM, so they are safe at any width; SetRowDesc
         WRAPS, so without a limit of its own a description would run as a single line
         across an ultrawide. SetDescMaxWidth is that limit.

         840 IS CHOSEN, NOT ROUND. Under the previous 900 px column a description had
         about 824 px to work with (900 minus the row's 28 of padding, the 14 gutter to
         the control, and the control itself), so a cap at 840 CANNOT change a single
         line break that exists today — it only ever acts above the width that used to
         be the maximum. A tighter, typographically ideal measure (~500 px, near 90
         characters at SetDescSize) would re-wrap real strings today; that is a separate
         decision and nobody has asked for it.
         =================================================================== -->
    <sys:Double x:Key="SetDescMaxWidth">840</sys:Double>

    <!-- THE STATISTICS PAGE'S MEASURE. 760 for the tables, 16 of gutter, 310 for the side
         column: 1086, and the two columns sit LEFT with the surplus beyond them.

         The same decision the tournament entrant table already made in this tab, for the same
         reason its own comment gives - "without this the status column sits at the far right
         edge of the window, a thousand pixels from the name it describes, at which point it
         stops reading as a property of that name at all". A statistics row is that shape
         exactly: a name on the left and a figure hard right, and on a maximised 2560 panel the
         count of a card ended up two thousand pixels from the card.

         760 IS THE TOURNAMENT TABLE'S NUMBER, not a new one, and 1086 is under the 1100 default
         window - so at the size this page was designed at, and at every size below it, this
         cap CANNOT move anything. It only ever acts above the width that used to be the
         maximum, which is the same rule SetDescMaxWidth above was chosen by.

         Left, not centred: the four shapes tried on the settings surface are recorded above,
         and a centred cap put the emptiness into two quarters instead of one. Left also keeps
         the page's left edge where the header and the mod chips already are. -->
    <sys:Double x:Key="MpStatsMaxWidth">1086</sys:Double>
    <sys:Double x:Key="SetRailWidth">216</sys:Double>         <!-- launcher settings sidebar -->
    <sys:Double x:Key="SetModRailWidth">206</sys:Double>      <!-- per-mod properties sidebar -->

    <!-- Fixed action-column widths. The width must NOT follow the label, or the
         right edge of the column zigzags down the section. 88 = Open/Change/
         Restore/Use/Import, 112 = Verify/Repair/Check/Update, 132 = the wider
         per-mod maintenance actions. -->
    <sys:Double x:Key="SetActionWidthSm">88</sys:Double>
    <sys:Double x:Key="SetActionWidthMd">112</sys:Double>
    <sys:Double x:Key="SetActionWidthLg">132</sys:Double>
    <sys:Double x:Key="SetActionHeight">30</sys:Double>

    <!-- Toggle switch. 34x20 with a 16 px thumb leaves 2 px of track around it,
         which is why SetTogglePadding is 2 and not a derived value. -->
    <sys:Double x:Key="SetToggleWidth">34</sys:Double>
    <sys:Double x:Key="SetToggleHeight">20</sys:Double>
    <sys:Double x:Key="SetToggleThumbSize">16</sys:Double>
    <CornerRadius x:Key="SetToggleRadius">10</CornerRadius>   <!-- half of 20; WPF has no 999 idiom -->
    <CornerRadius x:Key="SetToggleThumbRadius">8</CornerRadius>

    <Thickness x:Key="SetRowPadding">14,13,14,13</Thickness>       <!-- setting row -->
    <Thickness x:Key="SetActionRowPadding">14,11,14,11</Thickness>  <!-- row whose control is a button -->
    <Thickness x:Key="SetContentPadding">20,18,20,20</Thickness>
    <Thickness x:Key="SetNavItemPadding">10,9,10,9</Thickness>
</ResourceDictionary>
